laim_id":"consensus-voting","evidence_ids":["ev_d8ace95f611b8eb8755885b728a4ae1c283769876761faef4e0ac4f4efa97a78","ev_7b8d1122ace50b8fa0da00fecfc994bca55e08cf30668663f2ddec288433bfef"],"text":"The TSC strives for consensus; if consensus cannot be reached, decisions are made by vote, with each voting member having one vote and at least two weeks to vote."},{"claim_id":"technical-major","evidence_ids":["ev_1b904cdc4966acc8871858cb7e06b6d59a9b84f831dd7bf532b2d2ff5dccc380"],"text":"Technical major decisions require a simple majority vote, or, if no majority within two weeks and no negative vote, explicit plus-two support from at least two TSC members."},{"claim_id":"governance-major","evidence_ids":["ev_7b8d1122ace50b8fa0da00fecfc994bca55e08cf30668663f2ddec288433bfef"],"text":"Governance major decisions, such as adding or removing TSC members or modifying the governance document, require a super-majority of at least two thirds of the entire TSC."},{"claim_id":"delegation","evidence_ids":["ev_a48bc57d93104ae2fa45af83bf57229bc431524fa5ccee7832e5986f3bbf2511","ev_0cf2c210f0766d4ff14ab6169342fe873d7399a5af8fd6ec4b3b80688edaf6ea"],"text":"The TSC may delegate decision making to maintainers of other Valkey organization projects and may overrule those projects' decisions, though with restraint."},{"claim_id":"membership-termination","evidence_ids":["ev_a48bc57d93104ae2fa45af83bf57229bc431524fa5ccee7832e5986f3bbf2511"],"text":"Maintainer access and TSC position end through involuntary removal by governance vote, written resignation, or a simple majority vote to remove a member unresponsive over six months."}],"generation_id":"sha256:6760b22e3e09ac0e2ac64c9c23b3a77733f5bd1f8f8c9704c66d2c69d1362b60","message":null,"outcome":"answer","request_fence":1,"request_id":"req_deployed-eval-a5ceba7a8b887085b422f7a1dd9d856d15e447a6e28b1bd97dab07f10b02ab38","request_revision":2},"response_sha256":"sha256:0799c7fafe86ed27ecb220a274bd1320a3eaa72288f9eac00b40dc4c8d4e18c9","run_id":"sha256:55dd1b0b6b2517ba568f46c5933984bf92a9895510cc3c2681e16c265ba37bc8"}
