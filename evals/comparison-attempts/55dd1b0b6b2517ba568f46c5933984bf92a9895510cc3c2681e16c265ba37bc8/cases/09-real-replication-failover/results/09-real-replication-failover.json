oc/topics/sentinel.md@b3b2743bfb80ec72438f90e97bdbfd3ee7fad003: https://github.com/valkey-io/valkey-doc/blob/b3b2743bfb80ec72438f90e97bdbfd3ee7fad003/topics/sentinel.md"],"claims":[{"claim_id":"async-replication","evidence_ids":["ev_e950d59a91dfab75d7c461ee35e4dc23160192f41aa046ffd2b7e3cfd0a9e438","ev_b6e0b15da4be1ce367ba26117dada5d9e2e439a301d1dec5d219cfbc8dad9adb"],"text":"Valkey replication is asynchronous; replicas use PSYNC to send their old primary replication ID and processed offset, allowing partial resynchronization, or a full dataset copy when insufficient backlog or unknown history."},{"claim_id":"coordinated-failover","evidence_ids":["ev_c5b1b7f739c17f5467a92481f51fc18cc153a23dec320a40c8abc4d65d63a9c6","ev_ab15e26bab1c93da7952dd0e71feadba48e66a71cb375ea36036deebc0836425"],"text":"FAILOVER runs a coordinated, non-synchronous failover: the primary pauses writes, waits for a replica to consume the replication stream, demotes itself, then sends PSYNC FAILOVER; it rolls back if rejected."},{"claim_id":"cluster-manual","evidence_ids":["ev_293963f78c22e7e3d6b6d18b1f66fe682a850f474ea7408bf6612e8655ace4d6"],"text":"In Valkey Cluster, CLUSTER FAILOVER performed on a replica avoids data loss by switching clients only after the new primary has processed the old primary's replication stream; writes block during failover."},{"claim_id":"sentinel-consistency","evidence_ids":["ev_225b0ec416616ff80113db29c733d63d7b078fa691e1af482a9aaae7db848ce9","ev_1ab18e398dfa6e4222c086c9aa5bdf186ece9d9768173944e21c8696e3c5168c"],"text":"With Sentinel, Valkey is eventually consistent with last-failover-wins merging, so acknowledged writes can be lost; Sentinel guarantees liveness and per-failover distinct configuration epochs."}],"generation_id":"sha256:6760b22e3e09ac0e2ac64c9c23b3a77733f5bd1f8f8c9704c66d2c69d1362b60","message":null,"outcome":"answer","request_fence":1,"request_id":"req_deployed-eval-990c3214c4e9207f5e67c964dd9fdcbfe8e9067d2ed5d3d2268a2ca72a89ba02","request_revision":2},"response_sha256":"sha256:fd733151d0012f8be60c55a980524e0dadbfbd5bc2baddfa73e17856ca476acc","run_id":"sha256:55dd1b0b6b2517ba568f46c5933984bf92a9895510cc3c2681e16c265ba37bc8"}
